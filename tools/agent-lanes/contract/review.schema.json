{
  "title": "LaneReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "required_changes"],
  "properties": {
    "status": {"type": "string", "enum": ["approve", "request_changes"]},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "detail"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
          "file": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    },
    "required_changes": {"type": "array", "items": {"type": "string"}}
  }
}
