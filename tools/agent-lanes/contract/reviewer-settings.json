{
  "permissions": {
    "deny": ["mcp__*", "Edit", "Write", "MultiEdit", "NotebookEdit"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": ["-3.12", "{AGENT_LANES_DIR}/contract/guard.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
