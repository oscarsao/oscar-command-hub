{
  "title": "LaneWorkerResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "branch", "head_sha", "changed_files", "tests", "questions", "next_steps", "risks"],
  "properties": {
    "status": {"type": "string", "enum": ["done", "needs_input", "failed"]},
    "summary": {"type": "string"},
    "branch": {"type": "string"},
    "head_sha": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code"],
      "properties": {
        "command": {"type": "string"},
        "exit_code": {"type": "integer"}
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "options", "recommended"],
        "properties": {
          "question": {"type": "string"},
          "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "maxLength": 40}},
          "recommended": {"type": "integer", "minimum": 0, "maximum": 3}
        }
      }
    },
    "for_oscar": {"type": "string", "maxLength": 300},
    "next_steps": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
